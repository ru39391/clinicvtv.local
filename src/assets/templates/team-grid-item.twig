<div class="team-item js-item">
  <picture>
    <source type="image/webp" srcset="{{ webp }}"/>
    <source type="image/jpeg" srcset="{{ thumb }}"/>
    <img class="team-item__img" src="{{ thumb }}" alt="{{ title }}"/>
  </picture>
  <div class="team-item__wrapper">
    <a class="team-item__title" href="{{ url }}">{{ title }}</a>
    <ul class="team-item__list js-item-content" data-start="опыт работы с" data-end="года"></ul>
  </div>
  <div class="team-item__footer">
    <a class="team-item__link" href="{{ url }}">Отзывы о докторе</a>
    <button
      class="btn btn-primary btn-sm js-modal-btn"
      type="button"
      data-target="form"
      data-title="{{ title }}, запись к специалисту - категория"
    >
      Записаться
    </button>
  </div>
</div>
