          <a class="card__link" href="#"></a>
        </div>
        <div class="card">
          <div class="card__header">
            <div class="card__media"><img class="img-fluid" src="src/assets/images/serv-6.png" alt="" /></div>
            <div class="card__title">Профилактика</div>
